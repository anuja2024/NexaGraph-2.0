# PostgreSQL
NEXAGRAPH_DB_HOST=localhost
NEXAGRAPH_DB_PORT=5432
NEXAGRAPH_DB_NAME=nexagraph
NEXAGRAPH_DB_USER=your_db_user
NEXAGRAPH_DB_PASSWORD=your_db_password

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180

# Authentication: replace with a random secret of at least 32 characters
NEXAGRAPH_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters

# MCP
NEXAGRAPH_API_BASE_URL=http://127.0.0.1:8001
NEXAGRAPH_USER_ID=your_user_id
NEXAGRAPH_PASSWORD=your_password

# n8n (optional; configure when using the integration)
NEXAGRAPH_N8N_API_KEY=your_n8n_api_key
